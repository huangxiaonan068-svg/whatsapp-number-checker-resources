{
  "manifest_version": 3,
  "name": "WhatsApp 号码格式校验",
  "version": "1.0.0",
  "description": "纯本地校验 WhatsApp 号码的 E.164 格式合法性：国家/地区码、号码长度、常见非法模式。不联网、不上传任何数据。",
  "action": {
    "default_title": "WhatsApp 号码格式校验",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
